NODE_ENV=development          # set to "production" on Render
PORT=4000

# Frontend / CORS (exact origins, comma-separated, no wildcards)
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
API_URL=http://localhost:4000 # use your ngrok URL when testing PayFast notifications

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=urban_cart

# Generate with the command above, minimum 32 characters
JWT_SECRET=

# PayFast (leave merchant fields blank to disable checkout)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=           # required in production
PAYFAST_SANDBOX=true

ADMIN_EMAIL=
RESEND_API_KEY=

# Phone OTP. In dev with no SMS provider, the code prints to the server console.
PHONE_OTP_REQUIRED=true
SMS_PROVIDER=                 # africastalking | twilio